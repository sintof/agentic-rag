# Class LiteLLM proxy key (OpenAI- and Gemini-compatible). Never commit the real .env.
GEMINI_API_KEY=sk-your-key-here

# Optional: web fallback search. Free tier at https://tavily.com (1000 searches/mo).
# If left blank, the web_search node degrades gracefully (returns no results, agent
# answers from documents only or says it doesn't know).
TAVILY_API_KEY=

# Qdrant: leave blank to run embedded (on-disk, no server needed).
QDRANT_URL=
QDRANT_COLLECTION=agentic_rag_docs

# Where uploaded documents are stored before ingestion
FILE_STORAGE_PATH=./uploads

# Retry cap for the self-correction loop
MAX_GENERATION_RETRIES=2
